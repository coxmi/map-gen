// copy this and edit file to your liking
// then run it through `npm run gen <file>`
{
    "gb": {
        // ISO_A2 codes of the countries to draw
        "include": ["GB", "IE"],

        // admin_1 names, or iso_3166_2 codes, to cut out of the map
        // run "npm run search <keyword>" to find them
        "exclude": ["Shetland Islands"]
    },

    "de": {
        "include": ["DE"],
        "exclude": []
    }
}
