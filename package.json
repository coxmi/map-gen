    "gen": "node src/gen-maps.mjs",
    "search": "node src/search.mjs"
  },
  "dependencies": {
    "mapshaper": "^0.7.67"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "fflate": "^0.8.3",
