{
  "name": "map-gen",
  "version": "0.1.0",
  "description": "Generate country SVGs from Natural Earth data",
  "bin": {
    "map-gen": "src/gen-maps.mjs",
    "map-fetch": "src/fetch-data.mjs",
    "map-search": "src/search.mjs"
  },
  "files": [
    "src/gen-maps.mjs",
    "src/fetch-data.mjs",
    "src/search.mjs",
    "src/jsonc.mjs",
    "src/naturalearth.mjs",
    "src/maps.example.jsonc",
    "README.md"
  ],
  "scripts": {
